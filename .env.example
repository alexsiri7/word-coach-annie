# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the Transaction mode pooler (port 6543) for best performance with Prisma.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google Docs Integration (FR8)
# From Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI Chat — Google Gemini (can also configure in UI)
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash-001
# Legacy aliases (still supported):
# AI_API_KEY=
# REQUESTY_API_KEY=
# REQUESTY_MODEL=

# Invite-only access control (optional)
# Comma-separated list of Google email addresses allowed to sign in.
# When set, all other emails are rejected at OAuth with a friendly message.
# When unset, any Google account can sign in.
ALLOWED_EMAILS=

# API Authentication (REQUIRED when exposed to the internet)
# Set this to a strong random token. All API and page requests will require it.
# Generate one with: openssl rand -hex 32
# When unset, authentication is disabled (local-only dev mode).
API_TOKEN=

# JWT secret for Google OAuth sessions.
# Generate one with: openssl rand -hex 32
# Falls back to API_TOKEN or ENCRYPTION_KEY if not set.
JWT_SECRET=

# Encryption key for sensitive data at rest (API keys in database).
# Generate one with: openssl rand -hex 32
# Falls back to API_TOKEN if set. When neither is set, encryption is disabled.
ENCRYPTION_KEY=

# MCP destructive tools (delete, restore_snapshot, etc.)
# Set to "true" to enable destructive tools in the MCP endpoint.
# When false/unset, destructive tools are hidden from MCP clients.
MCP_ALLOW_DESTRUCTIVE=false

# Feedback — GitHub issue creation (optional)
# Personal access token with "issues: write" permission on the feedback repo.
# Generate at: https://github.com/settings/tokens
GITHUB_FEEDBACK_TOKEN=
# Repository to file feedback issues in, e.g. "myorg/myrepo"
GITHUB_FEEDBACK_REPO=

# Sentry — source map uploads (optional, enables readable stack traces)
# Get an auth token at: https://sentry.io/settings/auth-tokens/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cloudflare Tunnel (Optional, for public access during development)
CLOUDFLARE_TUNNEL_TOKEN=

# Supabase Disk Monitoring (GitHub Actions only — not used by the app)
# Used by .github/workflows/supabase-disk-monitor.yml
# Must be the DIRECT connection URL (port 5432, not pooler 6543) for psql compatibility.
# These secrets must also be added to GitHub repository secrets (Settings > Secrets > Actions).
# Annie instance — same project as DATABASE_URL but with direct port:
ANNIE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Reli instance — separate Supabase project:
RELI_DATABASE_URL=postgresql://postgres.[reli-project-ref]:[password]@db.[reli-project-ref].supabase.co:5432/postgres
