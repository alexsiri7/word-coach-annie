# Google Docs Integration (FR8)
# From Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI Chat (Requesty LLM Gateway)
REQUESTY_API_KEY=
REQUESTY_MODEL=google/gemini-2.0-flash-001

# Cloudflare Tunnel (Optional, for public access during development)
CLOUDFLARE_TUNNEL_TOKEN=
