# Same node:22-slim digest as the production Dockerfile; update both together.
FROM node:26-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072

# Install system deps for Prisma and general tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    openssl \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for layer caching
COPY package.json package-lock.json* .npmrc ./
COPY prisma ./prisma
RUN npm ci

# Copy the rest of the app
COPY . .

# Generate Prisma client
RUN npx prisma generate 2>/dev/null || true

EXPOSE 3000

# Dev mode with hot reload; the container must listen beyond its own loopback for the
# published port to reach it (docker-compose.dev.yml publishes it on 127.0.0.1 only)
CMD ["npm", "run", "dev:lan"]
